rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles & protected personal maternal data
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      // Sub-collection for protected daily routine progress
      match /daily_routines/{routineId} {
        allow read, write: if isSignedIn();
      }

      // Sub-collection for protected Cardiff fetal kick logs
      match /kick_logs/{kickId} {
        allow read, write: if isSignedIn();
      }
    }

    // Emergency referrals & ambulance dispatch
    // Public read/create ensures emergency ambulance booking can never be blocked
    match /referrals/{referralId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }
  }
}
